#include <stdio.h>

// Function to calculate sum
int sum(int a, int b) {
    return a + b;
}

// Function to calculate difference
int difference(int a, int b) {
    return a - b;
}

int main() {
    int a, b;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    printf("Sum = %d\n", sum(a, b));
    printf("Difference = %d\n", difference(a, b));

    return 0;
}
